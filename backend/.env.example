# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-1.5-flash is free-tier friendly; gemini-1.5-pro is stronger but has lower free quota)
GEMINI_MODEL=gemini-1.5-flash

# Optional: if you fine-tuned a local model in Colab and want to use it INSTEAD of Gemini
USE_LOCAL_FINETUNED_MODEL=false
LOCAL_MODEL_PATH=./finetuned_jarvis_model
